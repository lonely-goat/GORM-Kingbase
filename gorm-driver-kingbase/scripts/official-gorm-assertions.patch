diff --git a/tests/kingbase_assertions_test.go b/tests/kingbase_assertions_test.go
--- /dev/null
+++ b/tests/kingbase_assertions_test.go
@@ -0,0 +1,24 @@
+package tests_test
+
+import (
+    "testing"
+    "gorm.io/gorm"
+)
+
+// A missing column or unknown size must not bypass the upstream switch cases.
+func assertKingbaseMigrationMetadata(t *testing.T, columns []gorm.ColumnType) {
+    t.Helper()
+    if DB.Dialector.Name() != "kingbase" { return }
+    want := map[string]bool{"id":true, "name":true, "salary":true, "birthday":true, "name_ignore_migration":true}
+    if len(columns) != len(want) { t.Fatalf("migration columns=%d, want %d",len(columns),len(want)) }
+    for _, column := range columns {
+        if !want[column.Name()] { t.Fatalf("unexpected or duplicated migration column %q",column.Name()) }
+        delete(want,column.Name())
+        switch column.Name() {
+        case "name", "name_ignore_migration":
+            if n,known:=column.Length(); !known || n<=0 {t.Fatalf("unknown/zero length for %s",column.Name())}
+        case "salary", "birthday":
+            if n,_,known:=column.DecimalSize(); !known || n<=0 {t.Fatalf("unknown/zero precision for %s",column.Name())}
+        }
+    }
+}
diff --git a/utils/tests/assert_equal_test.go b/utils/tests/assert_equal_test.go
--- /dev/null
+++ b/utils/tests/assert_equal_test.go
@@ -0,0 +1,23 @@
+package tests
+
+import (
+    "os"
+    "os/exec"
+    "strings"
+    "testing"
+)
+
+func TestAssertEqualReverseConversion(t *testing.T) {
+    if os.Getenv("GORM_ASSERT_NEGATIVE_CONTROL") == "yes" {
+        // This child must fail: only expect is convertible to got's type.
+        AssertEqual(t, [2]int{1,2}, []int{9,9})
+        return
+    }
+    AssertEqual(t, [2]int{1,2}, []int{1,2})
+    child := exec.Command(os.Args[0], "-test.run=^TestAssertEqualReverseConversion$", "-test.v")
+    child.Env = append(os.Environ(), "GORM_ASSERT_NEGATIVE_CONTROL=yes")
+    output,err := child.CombinedOutput()
+    if err == nil || !strings.Contains(string(output), "--- FAIL: TestAssertEqualReverseConversion") || !strings.Contains(string(output), "expect:") {
+        t.Fatalf("unequal reverse-convertible values were not rejected: err=%v output=%s",err,output)
+    }
+}

diff --git a/tests/sql_builder_test.go b/tests/sql_builder_test.go
--- a/tests/sql_builder_test.go
+++ b/tests/sql_builder_test.go
@@ -463,2 +463,9 @@ func assertEqualSQL(t *testing.T, expected string, actually string) {
 	expected = replaceQuoteInSQL(expected)
 	actually = replaceQuoteInSQL(actually)
+
+	// Kingbase Oracle mode expresses LIMIT/OFFSET with OFFSET/FETCH.
+	withOffset := regexp.MustCompile(`(?i)OFFSET (\d+) ROWS FETCH NEXT (\d+) ROWS? ONLY$`)
+	actually = withOffset.ReplaceAllString(actually, `LIMIT $2 OFFSET $1`)
+	fetchOnly := regexp.MustCompile(`(?i)FETCH NEXT (\d+) ROWS? ONLY$`)
+	actually = fetchOnly.ReplaceAllString(actually, `LIMIT $1`)
+
@@ -489,8 +489,8 @@ func replaceQuoteInSQL(sql string) string {
 	switch DB.Dialector.Name() {
 	case "postgres", "gaussdb":
 		sql = strings.ReplaceAll(sql, `"`, `"`)
-	case "mysql", "sqlite":
+	case "mysql", "sqlite", "kingbase":
 		sql = strings.ReplaceAll(sql, "`", `"`)
 	case "sqlserver":
 		sql = strings.ReplaceAll(sql, `'`, `"`)
